public SearchRequest buildSearchRequest() {
    // Range Query 생성
    RangeQuery rangeQuery = new RangeQuery.Builder()
        .field("datetime")
        .gte(JsonData.of("2026-02-01T00:00:00.000+09:00"))
        .lte(JsonData.of("2026-02-07T23:59:59.999+09:00"))
        .build();
    
    // Bool Query 생성
    BoolQuery boolQuery = new BoolQuery.Builder()
        .filter(new Query.Builder().range(rangeQuery).build())
        .build();
    
    // Script 소스
    String scriptSource = 
        "String keyword = doc['service_keyword'].value; " +
        "if (keyword.startsWith(\"SEARCH\")) { return 'SEARCH'; } " +
        "else if (keyword.startsWith(\"DIRECTION\")) { return 'DIRECTION'; } " +
        // ... 나머지 조건들
        "else { return 'DIRECTION'; }";
    
    // Script 생성
    Script script = new Script.Builder()
        .inline(i -> i.source(scriptSource))
        .build();
    
    // Sub-aggregation (sum) 생성
    SumAggregation sumAgg = new SumAggregation.Builder()
        .field("numHits")
        .build();
    
    // Terms Aggregation 생성
    TermsAggregation termsAgg = new TermsAggregation.Builder()
        .script(script)
        .size(10000000)
        .build();
    
    // Aggregation 조합
    Aggregation byServiceAgg = new Aggregation.Builder()
        .terms(termsAgg)
        .aggregations("tot", new Aggregation.Builder()
            .sum(sumAgg)
            .build()
        )
        .build();
    
    // SearchRequest 리턴
    return new SearchRequest.Builder()
        .index("MLP-운영-d-100.120.13.52")
        .size(0)
        .query(new Query.Builder().bool(boolQuery).build())
        .aggregations("by_service", byServiceAgg)
        .build();
}