"use client";

import { useState, useEffect, useMemo } from "react";
import { GoodsItem } from "@/types/apiKey";

interface Props {
  open: boolean;
  allGoods: GoodsItem[];       // 백엔드에서 불러온 전체 상품 목록 (check: false 상태)
  initialGoods: GoodsItem[];   // 현재 form.services 기반 체크 상태
  onConfirm: (selected: GoodsItem[]) => void;
  onClose: () => void;
}

export default function ProductSettingModal({
  open,
  allGoods,
  initialGoods,
  onConfirm,
  onClose,
}: Props) {
  // key: group_code, value: GoodsItem
  const [goodsMap, setGoodsMap] = useState<Map<string, GoodsItem>>(new Map());

  // 모달 열릴 때마다 초기 체크 상태 세팅
  useEffect(() => {
    if (!open) return;

    // 현재 매핑된 group_code Set
    const existingCodes = new Set(initialGoods.map((g) => g.group_code));

    // 전체 상품 → 기존에 있던 항목이면 check: true
    const map = new Map<string, GoodsItem>();
    allGoods.forEach((goods) => {
      map.set(goods.group_code, {
        ...goods,
        check: existingCodes.has(goods.group_code),
      });
    });

    setGoodsMap(map);
  }, [open, allGoods, initialGoods]);

  const allItems = useMemo(() => Array.from(goodsMap.values()), [goodsMap]);

  const isAllChecked = allItems.length > 0 && allItems.every((g) => g.check);

  const handleToggleAll = () => {
    setGoodsMap((prev) => {
      const next = new Map(prev);
      allItems.forEach((g) => {
        next.set(g.group_code, { ...g, check: !isAllChecked });
      });
      return next;
    });
  };

  const handleToggle = (group_code: string) => {
    setGoodsMap((prev) => {
      const next = new Map(prev);
      const item = next.get(group_code);
      if (item) next.set(group_code, { ...item, check: !item.check });
      return next;
    });
  };

  const handleConfirm = () => {
    onConfirm(allItems.filter((g) => g.check));
    onClose();
  };

  const checkedCount = allItems.filter((g) => g.check).length;

  if (!open) return null;

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/40">
      <div className="bg-white w-[500px] rounded shadow-lg">
        {/* Header */}
        <div className="flex items-center justify-between bg-gray-700 text-white px-4 py-2">
          <span className="font-semibold">상품 설정</span>
          <button onClick={onClose} className="text-white hover:text-gray-300 text-lg">
            ✕
          </button>
        </div>

        <div className="p-4 space-y-4">
          <div>
            <p className="text-sm font-medium mb-1">상품 목록</p>
            <div className="border rounded overflow-hidden">
              {/* 헤더 */}
              <div className="bg-gray-700 text-white grid grid-cols-[40px_1fr] text-sm">
                <div className="flex items-center justify-center py-2">
                  <input
                    type="checkbox"
                    checked={isAllChecked}
                    onChange={handleToggleAll}
                    className="w-4 h-4"
                  />
                </div>
                <div className="py-2 px-3 font-medium">상품명</div>
              </div>

              {/* 상품 행 */}
              <div className="max-h-48 overflow-y-auto divide-y">
                {allItems.length === 0 ? (
                  <div className="text-center text-sm text-gray-400 py-6">
                    상품이 없습니다.
                  </div>
                ) : (
                  allItems.map((item) => (
                    <label
                      key={item.group_code}
                      className="grid grid-cols-[40px_1fr] items-center hover:bg-gray-50 cursor-pointer"
                    >
                      <div className="flex items-center justify-center py-2">
                        <input
                          type="checkbox"
                          checked={item.check}
                          onChange={() => handleToggle(item.group_code)}
                          className="w-4 h-4"
                        />
                      </div>
                      <div className="py-2 px-3 text-sm">{item.group_name}</div>
                    </label>
                  ))
                )}
              </div>
            </div>

            <p className="text-xs text-gray-500 mt-1">
              전체 {allGoods.length}개 중 {checkedCount}개 선택됨
            </p>
          </div>

          {/* 버튼 */}
          <div className="flex justify-center gap-2 pt-2">
            <button
              onClick={handleConfirm}
              className="px-6 py-1.5 bg-gray-600 text-white text-sm rounded hover:bg-gray-700"
            >
              선택 완료
            </button>
            <button
              onClick={onClose}
              className="px-6 py-1.5 bg-white border text-sm rounded hover:bg-gray-50"
            >
              취소
            </button>
          </div>
        </div>
      </div>
    </div>
  );
}
