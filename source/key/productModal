"use client";

import { useState, useEffect, useMemo } from "react";
import { GoodsItem, GroupCodeInfo } from "@/types/apiKey";

interface Props {
  open: boolean;
  allGroupCodes: GroupCodeInfo[];   // 백엔드에서 불러온 전체 상품 목록
  initialGoods: GoodsItem[];        // 수정 모드: 기존 매핑된 상품들 (등록이면 [])
  onConfirm: (selected: GoodsItem[]) => void;
  onClose: () => void;
}

// group_type 목록을 allGroupCodes에서 distinct하게 추출
function getGroupTypes(allGroupCodes: GroupCodeInfo[]): string[] {
  return Array.from(new Set(allGroupCodes.map((g) => g.group_type)));
}

export default function ProductSettingModal({
  open,
  allGroupCodes,
  initialGoods,
  onConfirm,
  onClose,
}: Props) {
  const groupTypes = useMemo(() => getGroupTypes(allGroupCodes), [allGroupCodes]);

  const [selectedGroupType, setSelectedGroupType] = useState<string>("");

  // key: group_code, value: GoodsItem
  const [goodsMap, setGoodsMap] = useState<Map<string, GoodsItem>>(new Map());

  // 모달 열릴 때마다 초기 상태 세팅
  useEffect(() => {
    if (!open) return;

    setSelectedGroupType(groupTypes[0] ?? "");

    // 기존 매핑된 항목을 group_code 기준으로 빠르게 조회하기 위해 Map화
    const existingMap = new Map(initialGoods.map((g) => [g.groupCodeInfo.group_code, g]));

    // 백엔드 상품 목록 전체를 GoodsItem으로 변환
    // 핵심: 기존 매핑된 항목이면 check: true + 기존 serviceOptions 유지
    const map = new Map<string, GoodsItem>();
    allGroupCodes.forEach((groupCodeInfo) => {
      const existing = existingMap.get(groupCodeInfo.group_code);
      map.set(groupCodeInfo.group_code, existing
        ? { ...existing, check: true }
        : { groupCodeInfo, check: false, serviceOptions: { options: "", limit_size: 0 } }
      );
    });

    setGoodsMap(map);
  }, [open, allGroupCodes, initialGoods, groupTypes]);

  // 현재 선택된 group_type의 상품만 필터링
  const filteredGoods = useMemo(
    () => Array.from(goodsMap.values()).filter((g) => g.groupCodeInfo.group_type === selectedGroupType),
    [goodsMap, selectedGroupType]
  );

  // 전체 선택 여부 (현재 탭 기준)
  const isAllChecked =
    filteredGoods.length > 0 && filteredGoods.every((g) => g.check);

  const handleToggleAll = () => {
    setGoodsMap((prev) => {
      const next = new Map(prev);
      filteredGoods.forEach((g) => {
        next.set(g.groupCodeInfo.group_code, { ...g, check: !isAllChecked });
      });
      return next;
    });
  };

  const handleToggle = (group_code: string) => {
    setGoodsMap((prev) => {
      const next = new Map(prev);
      const item = next.get(group_code);
      if (item) next.set(group_code, { ...item, check: !item.check });
      return next;
    });
  };

  const handleConfirm = () => {
    const selected = Array.from(goodsMap.values()).filter((g) => g.check);
    onConfirm(selected);
    onClose();
  };

  const checkedCount = Array.from(goodsMap.values()).filter((g) => g.check).length;

  if (!open) return null;

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/40">
      <div className="bg-white w-[500px] rounded shadow-lg">
        {/* Header */}
        <div className="flex items-center justify-between bg-gray-700 text-white px-4 py-2">
          <span className="font-semibold">상품 설정</span>
          <button onClick={onClose} className="text-white hover:text-gray-300 text-lg">
            ✕
          </button>
        </div>

        <div className="p-4 space-y-4">
          {/* ① 상품 그룹 선택 (group_type 기준 라디오) */}
          <div className="flex items-center gap-4">
            <span className="text-sm font-medium w-24 shrink-0">상품 그룹 선택</span>
            <div className="flex gap-4">
              {groupTypes.map((type) => (
                <label key={type} className="flex items-center gap-1 cursor-pointer text-sm">
                  <input
                    type="radio"
                    name="groupType"
                    value={type}
                    checked={selectedGroupType === type}
                    onChange={() => setSelectedGroupType(type)}
                    className="accent-blue-600"
                  />
                  {type}
                </label>
              ))}
            </div>
          </div>

          {/* ② 상품 목록 */}
          <div>
            <p className="text-sm font-medium mb-1">상품 목록</p>
            <div className="border rounded overflow-hidden">
              {/* 테이블 헤더 */}
              <div className="bg-gray-700 text-white grid grid-cols-[40px_1fr] text-sm">
                <div className="flex items-center justify-center py-2">
                  <input
                    type="checkbox"
                    checked={isAllChecked}
                    onChange={handleToggleAll}
                    className="w-4 h-4"
                  />
                </div>
                <div className="py-2 px-3 font-medium">상품명</div>
              </div>

              {/* 상품 행 */}
              <div className="max-h-48 overflow-y-auto divide-y">
                {filteredGoods.length === 0 ? (
                  <div className="text-center text-sm text-gray-400 py-6">
                    해당 그룹의 상품이 없습니다.
                  </div>
                ) : (
                  filteredGoods.map((item) => (
                    <label
                      key={item.groupCodeInfo.group_code}
                      className="grid grid-cols-[40px_1fr] items-center hover:bg-gray-50 cursor-pointer"
                    >
                      <div className="flex items-center justify-center py-2">
                        <input
                          type="checkbox"
                          checked={item.check}
                          onChange={() => handleToggle(item.groupCodeInfo.group_code)}
                          className="w-4 h-4"
                        />
                      </div>
                      <div className="py-2 px-3 text-sm">{item.groupCodeInfo.group_name}</div>
                    </label>
                  ))
                )}
              </div>
            </div>

            <p className="text-xs text-gray-500 mt-1">
              전체 {allGroupCodes.length}개 중 {checkedCount}개 선택됨
            </p>
          </div>

          {/* ③ 버튼 */}
          <div className="flex justify-center gap-2 pt-2">
            <button
              onClick={handleConfirm}
              className="px-6 py-1.5 bg-gray-600 text-white text-sm rounded hover:bg-gray-700"
            >
              선택 완료
            </button>
            <button
              onClick={onClose}
              className="px-6 py-1.5 bg-white border text-sm rounded hover:bg-gray-50"
            >
              취소
            </button>
          </div>
        </div>
      </div>
    </div>
  );
}
