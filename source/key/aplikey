export type ProductGroup = "자동차그룹사" | "그룹사" | "그룹사 외";

// 공통코드로 관리되는 값들은 string으로 선언
export type AppRestriction = string;  // 공통코드 그룹: APP_RESTRICTION
export type UseYn = string;           // 공통코드 그룹: USE_YN

export interface Product {
  productId: string;
  productName: string;
  productCode: string;
  productGroup: ProductGroup;
}

export interface ServiceOption {
  optionId: string;
  serviceApi: string;    // e.g. /v1/reverselabel
  optionFormat: string;  // e.g. FIXED
  value: string;         // e.g. limited
  key: string;           // e.g. 1
}

export interface MappedProduct {
  productId: string;
  productName: string;
  productCode: string;
  productGroup: ProductGroup;
  useYn: UseYn;
  options: ServiceOption[];
}

export interface ApiKeyFormData {
  // 담당자 정보
  requesterName: string;
  email: string;
  organization: string;
  department: string;
  requestDate: string;
  expiryDate: string;
  useYn: UseYn;

  // 서비스 정보
  serviceName: string;
  webDomain: string;
  iosBundleId: string;
  androidPackageName: string;

  // 애플리케이션 제한
  appRestriction: AppRestriction;

  // 상품 설정 (1:N)
  mappedProducts: MappedProduct[];

  // API KEY
  apiKey?: string;
}

export interface ApiKeyDetail extends ApiKeyFormData {
  keyId: string;
  createdAt: string;
  updatedAt: string;
}