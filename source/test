Mono<List<DailyServiceUsage>> result = data.map(res ->
        res.aggregations().get("by_date").sterms().buckets().array().stream()
           .map(d -> {
               // 모든 서비스 0으로 초기화
               Map<String, Long> services = new LinkedHashMap<>();
               SERVICES.forEach(s -> services.put(s, 0L));

               d.aggregations().get("by_service").sterms().buckets().array()
                .forEach(svc -> services.put(
                        svc.key().stringValue(),
                        (long) svc.aggregations().get("total").sum().value()
                ));

               return new DailyServiceUsage(d.key().stringValue(), services);
           })
           .toList()
);