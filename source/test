Map<String, Map<String, Long>> result = new LinkedHashMap<>();

res.aggregations().get("by_date").sterms().buckets().array()
   .forEach(d -> {
       String date = d.key().stringValue();              // "20250704"
       Map<String, Long> byService = new LinkedHashMap<>();

       d.aggregations().get("by_service").sterms().buckets().array()
        .forEach(svc -> {
            String service = svc.key().stringValue();    // "MAP", "PLACE" ...
            long total = (long) svc.aggregations().get("total").sum().value();
            byService.put(service, total);
        });

       result.put(date, byService);
   });

