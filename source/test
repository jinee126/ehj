return data.map(res ->
        res.aggregations().get("by_date").sterms().buckets().array().stream()
           .map(d -> {
               Map<String, Long> list = d.aggregations().get("by_service").sterms().buckets().array().stream()
                       .collect(Collectors.toMap(
                               b -> b.key().stringValue(),
                               b -> (long) b.aggregations().get("total").sum().value()
                       ));

               return UsageResponse.UsageResponseData.builder()
                       .date(d.key().stringValue())
                       .mapUsage(list.getOrDefault("MAP", 0L))
                       .placeUsage(list.getOrDefault("PLACE", 0L))
                       .geoUsage(list.getOrDefault("GEOCODING", 0L))
                       .directionUsage(list.getOrDefault("DIRECTION", 0L))
                       .trafficUsage(list.getOrDefault("TRAFFIC", 0L))
                       .build();
           })
           .toList()
);

.loading {
  width: 100%;
  min-height: 200px;

  display: flex;
  justify-content: center;
  align-items: center;
}

.loading::before {
  content: '';
  width: 50px;
  height: 50px;

  background: url('/images/loading.png') center / contain no-repeat;

  animation: rotate 1s linear infinite;
}

@keyframes rotate {
  to {
    transform: rotate(360deg);
  }
}