data.map(res -> {
    Map<String, Map<String, Long>> map = new LinkedHashMap<>();

    res.aggregations().get("by_date").sterms().buckets().array()
       .forEach(d -> {
           Map<String, Long> byService = new LinkedHashMap<>();

           d.aggregations().get("by_service").sterms().buckets().array()
            .forEach(svc -> byService.put(
                    svc.key().stringValue(),
                    (long) svc.aggregations().get("total").sum().value()
            ));

           map.put(d.key().stringValue(), byService);
       });

    return map;
});