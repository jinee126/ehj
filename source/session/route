// app/api/session/route.ts
import { NextRequest, NextResponse } from 'next/server';
import { cookies } from 'next/headers';
import { verifyToken } from '@/lib/auth/verify';

// GET: 쿠키에서 토큰 읽어서 세션 정보 반환
export async function GET(request: NextRequest) {
  try {
    console.log('[session GET] 요청 받음');

    // 쿠키에서 토큰 가져오기
    const cookieStore = await cookies();
    const token = cookieStore.get('auth-token')?.value;

    if (!token) {
      console.error('[session GET] 쿠키에 토큰 없음');
      return NextResponse.json(
        { error: '인증 토큰이 없습니다' },
        { status: 401 }
      );
    }

    console.log('[session GET] 토큰 발견, 검증 시작');

    // 토큰 검증
    const verifiedUser = await verifyToken(token);

    if (!verifiedUser) {
      console.error('[session GET] 토큰 검증 실패');
      return NextResponse.json(
        { error: '유효하지 않은 토큰입니다' },
        { status: 401 }
      );
    }

    console.log('[session GET] 토큰 검증 성공:', verifiedUser.sub);

    // 사용자 세션 정보
    const userSession = {
      userId: verifiedUser.sub,
      email: verifiedUser.email,
      role: verifiedUser['custom:role'] || 'user',
      name: verifiedUser.name,
    };

    console.log('[session GET] 세션 정보 반환');

    return NextResponse.json(userSession);

  } catch (error) {
    console.error('[session GET] 에러:', error);
    return NextResponse.json(
      { error: '세션 처리 중 오류가 발생했습니다' },
      { status: 500 }
    );
  }
}

// POST: 기존 방식 유지 (필요시)
export async function POST(request: NextRequest) {
  try {
    console.log('[session POST] 요청 받음');

    const authHeader = request.headers.get('Authorization');

    if (!authHeader || !authHeader.startsWith('Bearer ')) {
      console.error('[session POST] Authorization 헤더 없음');
      return NextResponse.json(
        { error: '인증 토큰이 없습니다' },
        { status: 401 }
      );
    }

    const token = authHeader.substring(7);
    console.log('[session POST] 토큰 추출 완료');

    const verifiedUser = await verifyToken(token);

    if (!verifiedUser) {
      console.error('[session POST] 토큰 검증 실패');
      return NextResponse.json(
        { error: '유효하지 않은 토큰입니다' },
        { status: 401 }
      );
    }

    console.log('[session POST] 토큰 검증 성공:', verifiedUser.sub);

    const userSession = {
      userId: verifiedUser.sub,
      email: verifiedUser.email,
      role: verifiedUser['custom:role'] || 'user',
      name: verifiedUser.name,
    };

    console.log('[session POST] 세션 정보 반환');

    return NextResponse.json(userSession);

  } catch (error) {
    console.error('[session POST] 에러:', error);
    return NextResponse.json(
      { error: '세션 처리 중 오류가 발생했습니다' },
      { status: 500 }
    );
  }
}
