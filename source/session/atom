// atoms/authAtoms.ts
import { atom } from 'jotai';
import { fetchAuthSession, signOut } from 'aws-amplify/auth';

export interface UserSession {
  userId: string;
  email: string;
  role: string; // 'manager', 'user', 'admin' 등
  name?: string;
  // 필요한 다른 정보들
}

// 세션 데이터 저장소
export const userSessionAtom = atom<UserSession | null>(null);

// 로딩 상태
export const sessionLoadingAtom = atom<boolean>(false);

// 세션 로드 액션
export const loadSessionAtom = atom(
  null,
  async (get, set) => {
    set(sessionLoadingAtom, true);

    try {
      const session = await fetchAuthSession();
      const idToken = session.tokens?.idToken?.toString();

      if (!idToken) {
        throw new Error('토큰이 없습니다');
      }

      const response = await fetch('/api/session', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${idToken}`,
        },
      });

      if (!response.ok) {
        throw new Error('세션 로드 실패');
      }

      const userData: UserSession = await response.json();
      set(userSessionAtom, userData);
      return userData;

    } catch (error) {
      console.error('세션 로드 에러:', error);
      set(userSessionAtom, null);
      throw error;
    } finally {
      set(sessionLoadingAtom, false);
    }
  }
);

// 로그아웃 액션
export const logoutAtom = atom(
  null,
  async (get, set) => {
    await signOut();
    set(userSessionAtom, null);
  }
);