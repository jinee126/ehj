'use client';

import { useSetAtom } from 'jotai';
import { loadCommonCodeFamily } from '@/atoms/commonCodeAtom';
import { useEffect } from 'react';

export function AppProvider({ children }: { children: React.ReactNode }) {
  // 자주 쓰는 공통코드들을 미리 로드
  const loadUseYn = useSetAtom(loadCommonCodeFamily('USE_YN'));
  const loadAuthType = useSetAtom(loadCommonCodeFamily('AUTH_TYPE'));
  const loadStatus = useSetAtom(loadCommonCodeFamily('STATUS'));

  useEffect(() => {
    // 앱 시작할 때 필수 공통코드들 미리 로드
    loadUseYn();
    loadAuthType();
    loadStatus();
    // ... 다른 자주 쓰는 코드들
  }, []);

  return <>{children}</>;
}