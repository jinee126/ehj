// providers/AppProvider.tsx
'use client';
import { useAtom, useAtomValue, useSetAtom } from 'jotai';
import {
  commonCodesAtom,
  commonCodesLoadingAtom,
  CommonCode,
  CommonCodeRaw
} from '@/atoms/commonCodeAtom';
import { loadSessionAtom } from '@/atoms/authAtoms';
import { useEffect, useState } from 'react';

export function AppProvider({ children }: { children: React.ReactNode }) {
  const [codes, setCodes] = useAtom(commonCodesAtom);
  const setCodesLoading = useSetAtom(commonCodesLoadingAtom);
  const loadSession = useSetAtom(loadSessionAtom);
  const [isInitialized, setIsInitialized] = useState(false);

  useEffect(() => {
    async function initialize() {
      // 공통코드와 세션을 동시에 로드 (병렬 처리로 더 빠름)
      const results = await Promise.allSettled([
        loadAllCommonCodes(),
        loadSession()
      ]);

      // 결과 확인
      if (results[0].status === 'fulfilled') {
        console.log('[공통코드] 로드 성공');
      } else {
        console.error('[공통코드] 로드 실패:', results[0].reason);
      }

      if (results[1].status === 'fulfilled') {
        console.log('[세션] 복원 성공');
      } else {
        console.log('[세션] 로그인 안됨');
      }

      setIsInitialized(true);
    }

    async function loadAllCommonCodes() {
      if (Object.keys(codes).length > 0) {
        console.log('[공통코드] 이미 로드됨');
        return;
      }

      try {
        setCodesLoading(true);
        console.log('[공통코드] 전체 로드 시작');

        const response = await fetch('/api/common-codes/all');
        const result = await response.json();
        const rawCodes: CommonCodeRaw[] = result.data;

        const grouped: Record<string, CommonCode[]> = {};
        rawCodes.forEach(item => {
          const key = item.categorization_code;
          if (!grouped[key]) {
            grouped[key] = [];
          }
          grouped[key].push({
            code: item.code,
            code_value: item.code_value
          });
        });

        setCodes(grouped);
        console.log('[공통코드] 로드 완료');
      } finally {
        setCodesLoading(false);
      }
    }

    initialize();
  }, []);

  if (!isInitialized) {
    return (
      <div className="flex items-center justify-center min-h-screen">
        <div>앱 초기화 중...</div>
      </div>
    );
  }

  return <>{children}</>;
}

// 기존 훅들은 그대로 유지
export function useCommonCode(categorizationCode: string): CommonCode[] {
  const codes = useAtomValue(commonCodesAtom);
  return codes[categorizationCode] || [];
}

export function useCommonCodeLoading(): boolean {
  return useAtomValue(commonCodesLoadingAtom);
}

export function useRefreshCommonCodes() {
  const setCodes = useSetAtom(commonCodesAtom);
  const setLoading = useSetAtom(commonCodesLoadingAtom);

  return async () => {
    try {
      setLoading(true);
      console.log('[공통코드] 강제 새로고침');

      const response = await fetch('/api/common-codes/all');
      const result = await response.json();
      const rawCodes: CommonCodeRaw[] = result.data;

      const grouped: Record<string, CommonCode[]> = {};
      rawCodes.forEach(item => {
        const key = item.categorization_code;
        if (!grouped[key]) {
          grouped[key] = [];
        }
        grouped[key].push({
          code: item.code,
          code_value: item.code_value
        });
      });

      setCodes(grouped);
      console.log('[공통코드] 새로고침 완료');
    } catch (error) {
      console.error('[공통코드] 새로고침 실패:', error);
    } finally {
      setLoading(false);
    }
  };
}