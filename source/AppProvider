// components/providers/AppProvider.tsx
'use client';

import { useEffect, useState } from 'react';
import { useSetAtom } from 'jotai';
import { loadSessionAtom } from '@/atoms/authAtoms';
import { loadCommonCodesAtom } from '@/atoms/commonCodeAtoms';

export default function AppProvider({ children }: { children: React.ReactNode }) {
  const [isInitialized, setIsInitialized] = useState(false);
  const loadSession = useSetAtom(loadSessionAtom);
  const loadCommonCodes = useSetAtom(loadCommonCodesAtom);

  useEffect(() => {
    const initializeApp = async () => {
      try {
        // 공통코드와 세션을 동시에 로드 (병렬 처리)
        await Promise.allSettled([
          loadCommonCodes(),
          loadSession().catch(() => {
            // 세션 로드 실패는 무시 (로그인 안한 상태)
            console.log('세션 없음');
          })
        ]);
      } catch (error) {
        console.error('초기화 실패:', error);
      } finally {
        setIsInitialized(true);
      }
    };

    initializeApp();
  }, [loadSession, loadCommonCodes]);

  if (!isInitialized) {
    return (
      <div className="flex items-center justify-center min-h-screen">
        <div>로딩 중...</div>
      </div>
    );
  }

  return <>{children}</>;
}