// providers/AppProvider.tsx
'use client';

import { useAtom, useSetAtom } from 'jotai';
import {
  commonCodesAtom,
  commonCodesLoadingAtom,
  CommonCode,
  CommonCodeRaw
} from '@/atoms/commonCodeAtom';
import { loadSessionAtom, logoutAtom } from '@/atoms/authAtoms';
import { useEffect, useState } from 'react';
import { useRouter, usePathname } from 'next/navigation';

export function AppProvider({ children }: { children: React.ReactNode }) {
  const [codes, setCodes] = useAtom(commonCodesAtom);
  const setCodesLoading = useSetAtom(commonCodesLoadingAtom);
  const loadSession = useSetAtom(loadSessionAtom);
  const logout = useSetAtom(logoutAtom);
  const [isInitialized, setIsInitialized] = useState(false);
  const router = useRouter();
  const pathname = usePathname();

  useEffect(() => {
    console.log('[AppProvider] useEffect 실행');

    async function initialize() {
      console.log('[AppProvider] initialize 시작');

      try {
        // 공통코드와 세션 동시 로드
        const results = await Promise.allSettled([
          loadAllCommonCodes(),
          loadSession()
        ]);

        // 공통코드 결과
        if (results[0].status === 'fulfilled') {
          console.log('[공통코드] 로드 성공');
        } else {
          console.error('[공통코드] 로드 실패:', results[0].reason);
        }

        // 세션 결과
        if (results[1].status === 'fulfilled') {
          console.log('[세션] 로드 성공');
        } else {
          console.log('[세션] 로드 실패:', results[1].reason);

          // 로그인 페이지가 아닌 경우에만 처리
          const publicPaths = ['/sign-in', '/sign-up', '/forgot-password'];
          const isPublicPath = publicPaths.some(path => pathname.startsWith(path));

          if (!isPublicPath) {
            // 보호된 페이지에서 세션 로드 실패
            console.error('[세션] 보호된 페이지에서 세션 로드 실패 → 로그아웃');

            try {
              await logout();
              await fetch('/api/auth/clear-cookie', { method: 'POST' });
            } catch (logoutError) {
              console.error('[로그아웃] 실패:', logoutError);
            }

            router.push('/sign-in?reason=session-expired');
          }
        }
      } catch (error) {
        console.error('[AppProvider] initialize 에러:', error);
      } finally {
        setIsInitialized(true);
      }
    }

    async function loadAllCommonCodes() {
      if (Object.keys(codes).length > 0) {
        console.log('[공통코드] 이미 로드됨');
        return;
      }

      try {
        setCodesLoading(true);
        console.log('[공통코드] API 호출');

        const response = await fetch('/api/common-codes/all');

        if (!response.ok) {
          throw new Error(`HTTP ${response.status}`);
        }

        const result = await response.json();
        const rawCodes: CommonCodeRaw[] = result.data;

        const grouped: Record<string, CommonCode[]> = {};
        rawCodes.forEach(item => {
          const key = item.categorization_code;
          if (!grouped[key]) {
            grouped[key] = [];
          }
          grouped[key].push({
            code: item.code,
            code_value: item.code_value
          });
        });

        setCodes(grouped);
        console.log('[공통코드] 로드 완료');
      } catch (error) {
        console.error('[공통코드] 로드 에러:', error);
        throw error;
      } finally {
        setCodesLoading(false);
      }
    }

    initialize();
  }, [pathname]); // pathname 추가

  console.log('[AppProvider] 렌더링, isInitialized:', isInitialized);

  if (!isInitialized) {
    return (
      <div className="flex items-center justify-center min-h-screen">
        <div>앱 초기화 중...</div>
      </div>
    );
  }

  return <>{children}</>;
}

