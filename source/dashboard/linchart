import {
  LineChart,
  Line,
  CartesianGrid,
  XAxis,
  YAxis,
  Tooltip,
  Legend,
  ResponsiveContainer,
} from 'recharts';

const data: { name: string; uv: number; pv: number; amt: number }[] = [
  { name: 'Page G', uv: 3490, pv: 4300, amt: 2100 },
];

const MyLineChart: () => Element = () => {
  return (
    <div style={{ width: '100%', height: 300 }}>
      {/* ResponsiveContainer를 사용하여 차트가 부모 요소의 크기에 맞게 조절되도록 합니다 */}
      <ResponsiveContainer>
        <LineChart
          data={data}
          margin={{
            top: 20,
            right: 30,
            left: 20,
            bottom: 5,
          }}
        >
          {/* 차트의 배경에 격자선을 추가합니다. */}
          <CartesianGrid strokeDasharray="3 3" />
          {/* X축 (데이터의 'name' 속성을 표시) */}
          <XAxis dataKey="name" />
          {/* Y축 */}
          <YAxis />
          {/* 툴팁 (마우스를 올렸을 때 데이터 표시) */}
          <Tooltip />
          {/* 범례 (각 Line의 의미 표시) */}
          <Legend />
          {/* 첫 번째 Line (데이터의 'pv' 값을 사용) */}
          <Line type="monotone" dataKey="pv" stroke="#8884d8" activeDot={{ r: 8 }} />
          {/* 두 번째 Line (데이터의 'uv' 값을 사용) */}
          <Line type="monotone" dataKey="uv" stroke="#82ca9d" />
        </LineChart>
      </ResponsiveContainer>
    </div>
  );
};

export default MyLineChart;