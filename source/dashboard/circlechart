import { PieChart, Pie, Cell, Tooltip, Legend, ResponsiveContainer } from 'recharts';

type PieDataItem = {
  name: string;
  value: number;
  color?: string; // 있으면 이 색 사용, 없으면 기본 팔레트에서 순환
};

type MyPieChartProps = {
  data: PieDataItem[];
  height?: number;
  colors?: string[]; // 기본 팔레트 (color 없는 항목에 순환 적용)
  innerRadius?: number;
  outerRadius?: number;
  showLegend?: boolean;
  showTooltip?: boolean;
  showLabel?: boolean;
};

const DEFAULT_COLORS = ['#8884d8', '#82ca9d', '#ffc658', '#ff7f7f', '#a4de6c', '#d0ed57'];

const MyPieChart = ({
  data,
  height = 300,
  colors = DEFAULT_COLORS,
  innerRadius = 0,
  outerRadius = 100,
  showLegend = true,
  showTooltip = true,
  showLabel = true,
}: MyPieChartProps) => {
  return (
    <div style={{ width: '100%', height }}>
      <ResponsiveContainer>
        <PieChart>
          {showTooltip && <Tooltip />}
          {showLegend && <Legend />}
          <Pie
            data={data}
            dataKey="value"
            nameKey="name"
            cx="50%"
            cy="50%"
            innerRadius={innerRadius}
            outerRadius={outerRadius}
            label={showLabel}
          >
            {data.map((item, index) => (
              <Cell
                key={`cell-${index}`}
                fill={item.color ?? colors[index % colors.length]}
              />
            ))}
          </Pie>
        </PieChart>
      </ResponsiveContainer>
    </div>
  );
};

export default MyPieChart;