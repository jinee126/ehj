'use client';

import { useEffect, useRef, useState } from 'react';
import { useRouter, useSearchParams } from 'next/navigation';
import { useAtom } from 'jotai';
import { atomWithReset, useResetAtom } from 'jotai/utils';
import { useCommonCode } from '@/hooks/useCommonCode';

// 폼 데이터 타입
interface ServiceForm {
  serviceApi: string;
  serviceName: string;
  groupName: string;
  useYn: string;
  sortOrder: number;
}

// 상품 그룹 타입
interface ProductGroup {
  groupCode: string;
  groupName: string;
}

// Atom 정의
export const serviceFormAtom = atomWithReset<ServiceForm>({
  serviceApi: '',
  serviceName: '',
  groupName: '',
  useYn: 'Y',
  sortOrder: 0
});

export default function ServiceManagePage() {
  const router = useRouter();
  const searchParams = useSearchParams();
  const mode = searchParams.get('mode');
  const serviceId = searchParams.get('id');

  const formRef = useRef<HTMLFormElement>(null);
  const useYnCodes = useCommonCode('USEYN');

  // 상품 그룹 목록 상태
  const [productGroups, setProductGroups] = useState<ProductGroup[]>([]);

  const [formData, setFormData] = useAtom(serviceFormAtom);
  const resetFormData = useResetAtom(serviceFormAtom);

  // 상품 그룹 목록 조회
  useEffect(() => {
    fetchProductGroups();
  }, []);

  useEffect(() => {
    resetFormData();

    if (mode === 'edit' && serviceId) {
      fetchServiceData(serviceId);
    }

    return () => {
      resetFormData();
    };
  }, [mode, serviceId]);

  // 상품 그룹 목록 가져오기
  const fetchProductGroups = async () => {
    try {
      const response = await fetch('/api/product-groups'); // API 경로는 실제에 맞게 수정
      const data = await response.json();
      setProductGroups(data);
    } catch (error) {
      console.error('상품 그룹 조회 실패:', error);
    }
  };

  const fetchServiceData = async (id: string) => {
    try {
      const response = await fetch(`/api/service/${id}`);
      const data = await response.json();

      setFormData({
        serviceApi: data.serviceApi || '',
        serviceName: data.serviceName || '',
        groupName: data.groupName || '',
        useYn: data.useYn || 'Y',
        sortOrder: data.sortOrder || 0
      });
    } catch (error) {
      console.error('데이터 조회 실패:', error);
    }
  };

  const isValidateCheck = (): boolean => {
    if (!formRef.current) return false;

    const isValid = formRef.current.reportValidity();

    if (!isValid) {
      return false;
    }

    if (!formData.serviceApi.trim()) {
      alert('서비스 API를 입력해주세요.');
      return false;
    }

    if (!formData.serviceName.trim()) {
      alert('서비스명을 입력해주세요.');
      return false;
    }

    if (!formData.groupName) {
      alert('상품 그룹을 선택해주세요.');
      return false;
    }

    if (!formData.useYn) {
      alert('사용 여부를 선택해주세요.');
      return false;
    }

    if (formData.sortOrder < 0) {
      alert('호출 제한 수는 0 이상이어야 합니다.');
      return false;
    }

    return true;
  };

  const handleChange = (e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement>) => {
    const { name, value } = e.target;
    setFormData(prev => ({
      ...prev,
      [name]: name === 'sortOrder' ? Number(value) : value
    }));
  };

  const handleSubmit = async () => {
    if (!isValidateCheck()) {
      return;
    }

    try {
      const url = mode === 'edit'
        ? `/api/service/${serviceId}`
        : '/api/service';

      const method = mode === 'edit' ? 'PUT' : 'POST';

      const saveData = {
        ...formData,
        editor: 'current_user_id' // 실제 사용자 ID로 변경
      };

      const response = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(saveData)
      });

      if (response.ok) {
        alert(mode === 'edit' ? '수정되었습니다.' : '등록되었습니다.');
        resetFormData();
        router.push('/service/list');
      }
    } catch (error) {
      console.error('저장 실패:', error);
    }
  };

  return (
    <div className="p-6">
      <h1 className="text-2xl font-bold mb-6">서비스 관리</h1>

      <div className="space-y-4">
        {/* 서비스 API */}
        <div>
          <label htmlFor="serviceApi" className="block mb-2">
            서비스 API <span className="text-red-500">*</span>
          </label>
          <input
            id="serviceApi"
            type="text"
            name="serviceApi"
            value={formData.serviceApi}
            onChange={handleChange}
            required
            className="border p-2 w-full rounded"
            placeholder="서비스 API를 입력하세요"
          />
        </div>

        {/* 서비스명 */}
        <div>
          <label htmlFor="serviceName" className="block mb-2">
            서비스명 <span className="text-red-500">*</span>
          </label>
          <input
            id="serviceName"
            type="text"
            name="serviceName"
            value={formData.serviceName}
            onChange={handleChange}
            required
            className="border p-2 w-full rounded"
            placeholder="서비스명을 입력하세요"
          />
        </div>

        {/* 상품 그룹 - 셀렉트박스 */}
        <div>
          <label htmlFor="groupName" className="block mb-2">
            상품 그룹 <span className="text-red-500">*</span>
          </label>
          <select
            id="groupName"
            name="groupName"
            value={formData.groupName}
            onChange={handleChange}
            required
            className="border p-2 w-full rounded"
          >
            <option value="">선택하세요</option>
            {productGroups.map((group) => (
              <option key={group.groupCode} value={group.groupCode}>
                {group.groupName}
              </option>
            ))}
          </select>
        </div>

        {/* 사용 여부 */}
        <div>
          <label className="block mb-2">
            사용 여부 <span className="text-red-500">*</span>
          </label>
          <div className="flex gap-4">
            {useYnCodes?.map((code) => (
              <label key={code.code} className="flex items-center cursor-pointer">
                <input
                  type="radio"
                  name="useYn"
                  value={code.code}
                  checked={formData.useYn === code.code}
                  onChange={handleChange}
                  required
                  className="mr-2"
                />
                {code.codeName}
              </label>
            ))}
          </div>
        </div>

        {/* 호출 제한 수 */}
        <div>
          <label htmlFor="sortOrder" className="block mb-2">
            호출 제한 수 <span className="text-red-500">*</span>
          </label>
          <input
            id="sortOrder"
            type="number"
            name="sortOrder"
            value={formData.sortOrder}
            onChange={handleChange}
            required
            min="0"
            className="border p-2 w-full rounded"
            placeholder="호출 제한 수를 입력하세요"
          />
        </div>

        {/* 버튼 */}
        <div className="flex gap-2 justify-end mt-6">
          <button
            type="button"
            onClick={() => {
              resetFormData();
              router.back();
            }}
            className="px-4 py-2 border rounded hover:bg-gray-50"
          >
            취소
          </button>