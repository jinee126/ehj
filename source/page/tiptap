'use client'

import { useEffect, useRef } from 'react'
import { useEditor, useEditorState, EditorContent } from '@tiptap/react'
import StarterKit from '@tiptap/starter-kit'
import Image from '@tiptap/extension-image'
import { Table, TableRow, TableHeader, TableCell } from '@tiptap/extension-table'

type Props = {
  value: string
  onChange: (html: string) => void
}

// 실제 업로드 API에 맞게 수정 (S3 presigned URL 방식이어도 결국 URL만 리턴하면 됨)
async function uploadImage(file: File): Promise<string> {
  const formData = new FormData()
  formData.append('file', file)
  const res = await fetch('/api/upload', { method: 'POST', body: formData })
  if (!res.ok) throw new Error('이미지 업로드 실패')
  const { url } = await res.json()
  return url
}

export default function TiptapEditor({ value, onChange }: Props) {
  const fileInputRef = useRef<HTMLInputElement>(null)

  const editor = useEditor({
    extensions: [
      StarterKit,
      Image.configure({ allowBase64: false }),
      Table.configure({ resizable: true }),
      TableRow,
      TableHeader,
      TableCell,
    ],
    content: value,
    immediatelyRender: false,
    onUpdate: ({ editor }) => onChange(editor.getHTML()),
  })

  // 툴바 활성 상태 구독 (v3는 기본적으로 트랜잭션마다 리렌더 안 해서 이게 필요)
  const state = useEditorState({
    editor,
    selector: ({ editor }) =>
      editor
        ? {
            isBold: editor.isActive('bold'),
            isItalic: editor.isActive('italic'),
            isH2: editor.isActive('heading', { level: 2 }),
            isBullet: editor.isActive('bulletList'),
            inTable: editor.isActive('table'),
            canMerge: editor.can().mergeCells(),
            canSplit: editor.can().splitCell(),
          }
        : null,
  })

  useEffect(() => {
    if (!editor || editor.getHTML() === value) return
    editor.commands.setContent(value, { emitUpdate: false })
  }, [value, editor])

  if (!editor || !state) return null

  const handleFileChange = async (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0]
    e.target.value = '' // 같은 파일 다시 선택 가능하게
    if (!file) return
    try {
      const url = await uploadImage(file)
      editor.chain().focus().setImage({ src: url, alt: file.name }).run()
    } catch {
      alert('이미지 업로드에 실패했어요.')
    }
  }

  const insertImageByUrl = () => {
    const url = window.prompt('이미지 URL')
    if (url) editor.chain().focus().setImage({ src: url }).run()
  }

  const cls = (active: boolean) => (active ? 'is-active' : '')

  return (
    <div className="editor-wrap">
      <div className="editor-toolbar">
        <button type="button" className={cls(state.isBold)}
          onClick={() => editor.chain().focus().toggleBold().run()}>B</button>
        <button type="button" className={cls(state.isItalic)}
          onClick={() => editor.chain().focus().toggleItalic().run()}>I</button>
        <button type="button" className={cls(state.isH2)}
          onClick={() => editor.chain().focus().toggleHeading({ level: 2 }).run()}>H2</button>
        <button type="button" className={cls(state.isBullet)}
          onClick={() => editor.chain().focus().toggleBulletList().run()}>• 목록</button>

        <span className="divider" />

        <button type="button" onClick={() => fileInputRef.current?.click()}>🖼 업로드</button>
        <button type="button" onClick={insertImageByUrl}>🔗 이미지 URL</button>
        <input ref={fileInputRef} type="file" accept="image/*" hidden onChange={handleFileChange} />

        <span className="divider" />

        <button type="button"
          onClick={() => editor.chain().focus().insertTable({ rows: 3, cols: 3, withHeaderRow: true }).run()}>
          ▦ 표 삽입
        </button>
      </div>

      {/* 커서가 표 안에 있을 때만 표 편집 툴바 노출 */}
      {state.inTable && (
        <div className="editor-toolbar sub">
          <button type="button" onClick={() => editor.chain().focus().addRowBefore().run()}>위 행+</button>
          <button type="button" onClick={() => editor.chain().focus().addRowAfter().run()}>아래 행+</button>
          <button type="button" onClick={() => editor.chain().focus().deleteRow().run()}>행 삭제</button>
          <span className="divider" />
          <button type="button" onClick={() => editor.chain().focus().addColumnBefore().run()}>왼쪽 열+</button>
          <button type="button" onClick={() => editor.chain().focus().addColumnAfter().run()}>오른쪽 열+</button>
          <button type="button" onClick={() => editor.chain().focus().deleteColumn().run()}>열 삭제</button>
          <span className="divider" />
          <button type="button" disabled={!state.canMerge}
            onClick={() => editor.chain().focus().mergeCells().run()}>셀 병합</button>
          <button type="button" disabled={!state.canSplit}
            onClick={() => editor.chain().focus().splitCell().run()}>셀 분할</button>
          <button type="button" onClick={() => editor.chain().focus().toggleHeaderRow().run()}>헤더 행</button>
          <span className="divider" />
          <button type="button" onClick={() => editor.chain().focus().deleteTable().run()}>표 삭제</button>
        </div>
      )}

      <EditorContent editor={editor} />
    </div>
  )
}