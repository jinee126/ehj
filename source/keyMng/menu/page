'use client';

import { useState, useCallback, useEffect } from 'react';

// ── 프로젝트 공통 모듈 (경로는 프로젝트에 맞게 수정) ──────────────
const BASE_URL      = process.env.NEXT_PUBLIC_API_BASE_URL ?? '';
const HTTP_METHOD   = { GET: 'GET', POST: 'POST', DELETE: 'DELETE' } as const;
const ResultCode    = { ET00: 'ET00' };
const ServerResCode = { OK: '200' };

// ── 타입 정의 ──────────────────────────────────────────────────────
interface MenuGroup {
  id:        number;
  groupName: string;
}

interface Page {
  id:       number;
  pageName: string;
  path:     string;
}

/** 플랫 메뉴 아이템 (서버 응답 / 저장 요청) */
interface MenuItemFlat {
  id:        number | null;
  parentId:  number | null;
  menuName:  string;
  pageId:    number | null;
  sortOrder: number;
  depth:     number;
  useYn:     'Y' | 'N';
  isNew?:    boolean;
  isDirty?:  boolean;
}

/** 트리 표현용 (children, UI 상태 추가) */
interface MenuItemTree extends MenuItemFlat {
  children:    MenuItemTree[];
  isExpanded:  boolean;
}

interface GroupPermission {
  menuGroupId: number;
  groupName:   string;
  pageId:      number | null;
  isSave:      boolean;
  isRead:      boolean;
  isDelete:    boolean;
  isDirty?:    boolean;
}

// ── 공통 API 호출 함수 ─────────────────────────────────────────────
async function callGetAPI(
  url:    string,
  method: string,
  params: Record<string, unknown>,
  body:   Record<string, unknown>,
) {
  const query =
    method === HTTP_METHOD.GET && Object.keys(params).length
      ? '?' + new URLSearchParams(params as Record<string, string>).toString()
      : '';

  const res = await fetch(`${url}${query}`, {
    method,
    headers: { 'Content-Type': 'application/json' },
    ...(method !== HTTP_METHOD.GET && { body: JSON.stringify(body) }),
  });
  return res.json();
}

// ── 트리 빌더 (flat → tree) ────────────────────────────────────────
function buildTree(flat: MenuItemFlat[]): MenuItemTree[] {
  const map = new Map<number | string, MenuItemTree>();

  flat.forEach((item) => {
    const key = item.id ?? `new_${item.menuName}_${item.sortOrder}`;
    map.set(key, { ...item, children: [], isExpanded: true });
  });

  const roots: MenuItemTree[] = [];

  map.forEach((node) => {
    if (node.parentId == null) {
      roots.push(node);
    } else {
      const parent = map.get(node.parentId);
      if (parent) parent.children.push(node);
      else roots.push(node); // 부모 없으면 루트로
    }
  });

  return roots;
}

// ── 트리에서 특정 노드 업데이트 ──────────────────────────────────
function updateNode(
  nodes: MenuItemTree[],
  targetId: number | null,
  updater: (n: MenuItemTree) => MenuItemTree,
): MenuItemTree[] {
  return nodes.map((n) => {
    if (n.id === targetId) return updater(n);
    return { ...n, children: updateNode(n.children, targetId, updater) };
  });
}

// ── 트리에서 특정 노드 제거 ───────────────────────────────────────
function removeNode(nodes: MenuItemTree[], targetId: number | null): MenuItemTree[] {
  return nodes
    .filter((n) => n.id !== targetId)
    .map((n) => ({ ...n, children: removeNode(n.children, targetId) }));
}

// ══════════════════════════════════════════════════════════════════
// ── 트리 노드 컴포넌트 ─────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════
interface TreeNodeProps {
  node:       MenuItemTree;
  depth:      number;
  selectedId: number | null;
  onSelect:   (node: MenuItemTree) => void;
  onDelete:   (node: MenuItemTree) => void;
  onToggle:   (id: number | null) => void;
}

function TreeNode({ node, depth, selectedId, onSelect, onDelete, onToggle }: TreeNodeProps) {
  const hasChildren = node.children.length > 0;
  const isSelected  = node.id !== null && node.id === selectedId;

  return (
    <div>
      <div
        style={{ paddingLeft: `${depth * 16 + 6}px` }}
        className={`
          flex items-center gap-1 py-[5px] pr-2 cursor-pointer rounded text-sm group
          ${isSelected
            ? 'bg-blue-50 text-blue-700 font-medium'
            : 'text-gray-700 hover:bg-gray-100'}
        `}
        onClick={() => onSelect(node)}
      >
        {/* 펼치기/접기 토글 */}
        <button
          className="w-4 h-4 flex items-center justify-center text-gray-400 hover:text-gray-600 shrink-0"
          onClick={(e) => {
            e.stopPropagation();
            if (hasChildren) onToggle(node.id);
          }}
        >
          {hasChildren
            ? (node.isExpanded
                ? <MinusBoxIcon />
                : <PlusBoxIcon />)
            : <EmptyBoxIcon />}
        </button>

        {/* 메뉴명 */}
        <span className="flex-1 truncate">
          {node.menuName || <span className="text-gray-400 italic">새 메뉴</span>}
          {node.isNew && (
            <span className="ml-1 text-[10px] text-orange-500 font-bold">NEW</span>
          )}
        </span>

        {/* 삭제 버튼 */}
        <button
          className="w-4 h-4 flex items-center justify-center text-gray-300 hover:text-red-500 opacity-0 group-hover:opacity-100 shrink-0 transition-opacity"
          onClick={(e) => { e.stopPropagation(); onDelete(node); }}
          title="삭제"
        >
          ✕
        </button>
      </div>

      {/* 자식 노드 */}
      {hasChildren && node.isExpanded && (
        <div>
          {node.children.map((child) => (
            <TreeNode
              key={child.id ?? child.menuName}
              node={child}
              depth={depth + 1}
              selectedId={selectedId}
              onSelect={onSelect}
              onDelete={onDelete}
              onToggle={onToggle}
            />
          ))}
        </div>
      )}
    </div>
  );
}

// ── 작은 SVG 아이콘 ────────────────────────────────────────────────
const MinusBoxIcon = () => (
  <svg viewBox="0 0 12 12" fill="none" className="w-3 h-3" xmlns="http://www.w3.org/2000/svg">
    <rect x="0.5" y="0.5" width="11" height="11" rx="1" stroke="currentColor"/>
    <line x1="2.5" y1="6" x2="9.5" y2="6" stroke="currentColor" strokeWidth="1.2"/>
  </svg>
);

const PlusBoxIcon = () => (
  <svg viewBox="0 0 12 12" fill="none" className="w-3 h-3" xmlns="http://www.w3.org/2000/svg">
    <rect x="0.5" y="0.5" width="11" height="11" rx="1" stroke="currentColor"/>
    <line x1="6" y1="2.5" x2="6" y2="9.5" stroke="currentColor" strokeWidth="1.2"/>
    <line x1="2.5" y1="6" x2="9.5" y2="6" stroke="currentColor" strokeWidth="1.2"/>
  </svg>
);

const EmptyBoxIcon = () => (
  <svg viewBox="0 0 12 12" fill="none" className="w-3 h-3" xmlns="http://www.w3.org/2000/svg">
    <rect x="0.5" y="0.5" width="11" height="11" rx="1" stroke="currentColor" opacity="0.3"/>
  </svg>
);

// ══════════════════════════════════════════════════════════════════
// ── 메인 컴포넌트 ──────────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════════
export default function MenuManager() {
  const [menuGroups,       setMenuGroups]       = useState<MenuGroup[]>([]);
  const [pages,            setPages]            = useState<Page[]>([]);
  const [selectedGroupId,  setSelectedGroupId]  = useState<number | ''>('');
  const [menuTree,         setMenuTree]         = useState<MenuItemTree[]>([]);
  const [selectedMenu,     setSelectedMenu]     = useState<MenuItemTree | null>(null);
  const [groupPermissions, setGroupPermissions] = useState<GroupPermission[]>([]);

  // ── 초기 로딩: 메뉴 그룹 + 페이지 목록 ─────────────────────────
  useEffect(() => {
    (async () => {
      const [grpRes, pageRes] = await Promise.all([
        callGetAPI(`${BASE_URL}/menu-groups`, HTTP_METHOD.GET, {}, {}),
        callGetAPI(`${BASE_URL}/pages`,       HTTP_METHOD.GET, {}, {}),
      ]);
      if (grpRes.resultCode === ResultCode.ET00 && grpRes.resCode === ServerResCode.OK) {
        setMenuGroups(grpRes.data);
      }
      if (pageRes.resultCode === ResultCode.ET00 && pageRes.resCode === ServerResCode.OK) {
        setPages(pageRes.data);
      }
    })();
  }, []);

  // ── 메뉴 그룹 변경 → 메뉴 목록 조회 ────────────────────────────
  const fetchMenuList = useCallback(async (groupId: number) => {
    const res = await callGetAPI(
      `${BASE_URL}/menus`,
      HTTP_METHOD.GET,
      { menuGroupId: String(groupId) },
      {},
    );
    if (res.resultCode === ResultCode.ET00 && res.resCode === ServerResCode.OK) {
      setMenuTree(buildTree(res.data));
      setSelectedMenu(null);
      setGroupPermissions([]);
    }
  }, []);

  const handleGroupChange = useCallback((e: React.ChangeEvent<HTMLSelectElement>) => {
    const val = e.target.value;
    setSelectedGroupId(val === '' ? '' : Number(val));
    if (val !== '') fetchMenuList(Number(val));
    else {
      setMenuTree([]);
      setSelectedMenu(null);
      setGroupPermissions([]);
    }
  }, [fetchMenuList]);

  // ── 메뉴 선택 → 권한 목록 조회 ──────────────────────────────────
  const handleSelectMenu = useCallback(async (node: MenuItemTree) => {
    setSelectedMenu(node);

    if (node.isNew || node.id == null) {
      // 신규 메뉴: 모든 그룹에 대해 빈 권한 행 초기화
      setGroupPermissions(
        menuGroups.map((g) => ({
          menuGroupId: g.id,
          groupName:   g.groupName,
          pageId:      null,
          isSave:      false,
          isRead:      false,
          isDelete:    false,
        })),
      );
      return;
    }

    const res = await callGetAPI(
      `${BASE_URL}/menus/${node.id}/permissions`,
      HTTP_METHOD.GET,
      {},
      {},
    );
    if (res.resultCode === ResultCode.ET00 && res.resCode === ServerResCode.OK) {
      setGroupPermissions(res.data);
    }
  }, [menuGroups]);

  // ── 트리 접기/펼치기 ─────────────────────────────────────────────
  const handleToggle = useCallback((id: number | null) => {
    setMenuTree((prev) =>
      updateNode(prev, id, (n) => ({ ...n, isExpanded: !n.isExpanded })),
    );
  }, []);

  // ── 트리 노드 삭제 ───────────────────────────────────────────────
  const handleDeleteNode = useCallback(async (node: MenuItemTree) => {
    if (!confirm(`"${node.menuName}" 메뉴를 삭제하시겠습니까?\n하위 메뉴도 함께 삭제됩니다.`)) return;

    if (node.isNew) {
      setMenuTree((prev) => removeNode(prev, node.id));
      if (selectedMenu?.id === node.id) {
        setSelectedMenu(null);
        setGroupPermissions([]);
      }
      return;
    }

    const res = await callGetAPI(
      `${BASE_URL}/menus/${node.id}`,
      HTTP_METHOD.DELETE,
      {},
      {},
    );
    if (res.resultCode === ResultCode.ET00 && res.resCode === ServerResCode.OK) {
      alert('삭제되었습니다.');
      if (selectedGroupId !== '') fetchMenuList(Number(selectedGroupId));
    }
  }, [selectedMenu, selectedGroupId, fetchMenuList]);

  // ── 메뉴 추가 (선택된 노드의 하위 or 루트) ─────────────────────
  const handleAddMenu = useCallback(() => {
    const tempId = -(Date.now()); // 임시 음수 ID (신규 구분용)
    const newNode: MenuItemTree = {
      id:         tempId,
      parentId:   selectedMenu?.id ?? null,
      menuName:   '',
      pageId:     null,
      sortOrder:  0,
      depth:      selectedMenu ? selectedMenu.depth + 1 : 0,
      useYn:      'Y',
      isNew:      true,
      children:   [],
      isExpanded: true,
    };

    if (selectedMenu) {
      // 선택된 노드의 children에 추가
      setMenuTree((prev) =>
        updateNode(prev, selectedMenu.id, (n) => ({
          ...n,
          isExpanded: true,
          children: [...n.children, newNode],
        })),
      );
    } else {
      // 루트에 추가
      setMenuTree((prev) => [...prev, newNode]);
    }

    setSelectedMenu(newNode);
    setGroupPermissions(
      menuGroups.map((g) => ({
        menuGroupId: g.id,
        groupName:   g.groupName,
        pageId:      null,
        isSave:      false,
        isRead:      false,
        isDelete:    false,
      })),
    );
  }, [selectedMenu, menuGroups]);

  // ── 선택된 메뉴 필드 변경 ────────────────────────────────────────
  const handleMenuFieldChange = useCallback((
    field: keyof MenuItemFlat,
    value: string | number | null,
  ) => {
    setSelectedMenu((prev) =>
      prev ? { ...prev, [field]: value, isDirty: true } : prev,
    );
    // 트리에도 메뉴명 반영
    if (field === 'menuName') {
      setMenuTree((prev) =>
        updateNode(prev, selectedMenu?.id ?? null, (n) => ({
          ...n,
          menuName: value as string,
        })),
      );
    }
  }, [selectedMenu?.id]);

  // ── 그룹 권한 변경 ───────────────────────────────────────────────
  const handlePermChange = useCallback((
    groupId: number,
    field:   keyof GroupPermission,
    value:   boolean | number | null,
  ) => {
    setGroupPermissions((prev) =>
      prev.map((p) =>
        p.menuGroupId === groupId ? { ...p, [field]: value, isDirty: true } : p,
      ),
    );
  }, []);

  // ── 저장 ─────────────────────────────────────────────────────────
  const handleSave = useCallback(async () => {
    if (!selectedMenu) {
      alert('저장할 메뉴를 선택해 주세요.');
      return;
    }
    if (!selectedMenu.menuName.trim()) {
      alert('메뉴명을 입력해 주세요.');
      return;
    }

    const res = await callGetAPI(
      `${BASE_URL}/menus`,
      HTTP_METHOD.POST,
      {},
      {
        menu:        selectedMenu,
        permissions: groupPermissions,
      },
    );

    if (res.resultCode === ResultCode.ET00 && res.resCode === ServerResCode.OK) {
      alert('저장되었습니다.');
      if (selectedGroupId !== '') fetchMenuList(Number(selectedGroupId));
    }
  }, [selectedMenu, groupPermissions, selectedGroupId, fetchMenuList]);

  // ── 취소 ─────────────────────────────────────────────────────────
  const handleCancel = useCallback(() => {
    if (selectedGroupId !== '') fetchMenuList(Number(selectedGroupId));
    setSelectedMenu(null);
    setGroupPermissions([]);
  }, [selectedGroupId, fetchMenuList]);

  // ── 선택된 메뉴의 페이지 경로 (읽기 전용) ───────────────────────
  const selectedPagePath = pages.find((p) => p.id === selectedMenu?.pageId)?.path ?? '';

  // ──────────────────────────────────────────────────────────────
  return (
    <div className="w-full min-h-screen bg-gray-50">
      {/* 페이지 헤더 */}
      <div className="px-6 py-4 border-b border-gray-200 bg-white">
        <div className="flex items-center gap-2">
          <span className="text-gray-400 text-sm">■</span>
          <h1 className="text-base font-semibold text-gray-800">메뉴 관리</h1>
        </div>
      </div>

      {/* 본문 */}
      <div className="flex gap-0 h-[calc(100vh-57px)]">

        {/* ══ 좌측 패널: 메뉴 그룹 + 트리 ══ */}
        <div className="w-64 border-r border-gray-200 bg-white flex flex-col shrink-0">

          {/* 메뉴 그룹 선택 */}
          <div className="p-3 border-b border-gray-200 bg-gray-50">
            <div className="flex items-center gap-2">
              <label className="text-xs font-semibold text-gray-600 whitespace-nowrap w-16 shrink-0">
                메뉴 그룹<span className="text-red-500">*</span>
              </label>
              <select
                value={selectedGroupId}
                onChange={handleGroupChange}
                className="flex-1 h-7 px-2 text-xs border border-gray-300 rounded focus:outline-none focus:ring-1 focus:ring-blue-500 bg-white"
              >
                <option value="">선택</option>
                {menuGroups.map((g) => (
                  <option key={g.id} value={g.id}>{g.groupName}</option>
                ))}
              </select>
            </div>
          </div>

          {/* 메뉴 목록 헤더 */}
          <div className="flex items-center justify-between px-3 py-2 border-b border-gray-200">
            <span className="text-xs font-semibold text-gray-700">메뉴 목록</span>
            <button
              onClick={handleAddMenu}
              disabled={selectedGroupId === ''}
              className="text-[11px] text-white bg-gray-500 rounded px-2 py-0.5 hover:bg-gray-600 disabled:opacity-40 disabled:cursor-not-allowed"
            >
              + 추가
            </button>
          </div>

          {/* 트리 영역 */}
          <div className="flex-1 overflow-auto p-1">
            {selectedGroupId === '' ? (
              <div className="text-center py-12 text-xs text-gray-400">
                메뉴 그룹을 선택하세요
              </div>
            ) : menuTree.length === 0 ? (
              <div className="text-center py-12 text-xs text-gray-400">
                등록된 메뉴가 없습니다
              </div>
            ) : (
              menuTree.map((node) => (
                <TreeNode
                  key={node.id}
                  node={node}
                  depth={0}
                  selectedId={selectedMenu?.id ?? null}
                  onSelect={handleSelectMenu}
                  onDelete={handleDeleteNode}
                  onToggle={handleToggle}
                />
              ))
            )}
          </div>
        </div>

        {/* ══ 우측 패널: 상세 설정 ══ */}
        <div className="flex-1 flex flex-col overflow-hidden">

          {!selectedMenu ? (
            <div className="flex-1 flex items-center justify-center">
              <div className="text-center">
                <div className="text-3xl text-gray-200 mb-3">☰</div>
                <p className="text-sm text-gray-400">좌측에서 메뉴를 선택하거나 추가하세요</p>
              </div>
            </div>
          ) : (
            <div className="flex-1 overflow-auto p-4 flex flex-col gap-4">

              {/* ── 페이지 설정 섹션 ── */}
              <div className="bg-white border border-gray-200 rounded">
                <div className="px-4 py-2 border-b border-gray-200 bg-gray-50">
                  <span className="text-xs font-semibold text-gray-700 uppercase tracking-wide">
                    ③ 페이지 설정
                  </span>
                </div>
                <div className="p-4 grid grid-cols-[120px_1fr] gap-y-3 gap-x-3 items-center">

                  {/* 메뉴명 */}
                  <label className="text-xs text-gray-600 text-right">
                    메뉴명<span className="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    value={selectedMenu.menuName}
                    onChange={(e) => handleMenuFieldChange('menuName', e.target.value)}
                    placeholder="메뉴명 입력"
                    className="h-8 px-3 text-sm border border-gray-300 rounded focus:outline-none focus:ring-1 focus:ring-blue-500"
                  />

                  {/* 페이지 명 */}
                  <label className="text-xs text-gray-600 text-right">페이지 명</label>
                  <select
                    value={selectedMenu.pageId ?? ''}
                    onChange={(e) =>
                      handleMenuFieldChange('pageId', e.target.value ? Number(e.target.value) : null)
                    }
                    className="h-8 px-2 text-sm border border-gray-300 rounded focus:outline-none focus:ring-1 focus:ring-blue-500 bg-white"
                  >
                    <option value="">선택</option>
                    {pages.map((p) => (
                      <option key={p.id} value={p.id}>{p.pageName}</option>
                    ))}
                  </select>

                  {/* 페이지 경로 (읽기 전용) */}
                  <label className="text-xs text-gray-600 text-right">
                    페이지 경로<span className="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    value={selectedPagePath}
                    readOnly
                    placeholder="페이지 선택 시 자동 입력"
                    className="h-8 px-3 text-sm border border-gray-200 rounded bg-gray-50 text-gray-500 cursor-default"
                  />
                </div>
              </div>

              {/* ── 그룹 설정 섹션 ── */}
              <div className="bg-white border border-gray-200 rounded flex-1">
                <div className="px-4 py-2 border-b border-gray-200 bg-gray-50">
                  <span className="text-xs font-semibold text-gray-700 uppercase tracking-wide">
                    ⑤ 그룹 설정
                  </span>
                </div>
                <div className="overflow-auto">
                  <table className="w-full text-sm">
                    <thead>
                      <tr className="bg-gray-800 text-white">
                        <th className="text-left p-3 text-xs font-medium">메뉴 그룹</th>
                        <th className="text-left p-3 text-xs font-medium">페이지</th>
                        <th className="text-center p-3 text-xs font-medium w-16">저장</th>
                        <th className="text-center p-3 text-xs font-medium w-16">조회</th>
                        <th className="text-center p-3 text-xs font-medium w-16">삭제</th>
                      </tr>
                    </thead>
                    <tbody>
                      {groupPermissions.length === 0 ? (
                        <tr>
                          <td colSpan={5} className="text-center py-10 text-xs text-gray-400">
                            데이터가 없습니다.
                          </td>
                        </tr>
                      ) : (
                        groupPermissions.map((perm) => (
                          <tr
                            key={perm.menuGroupId}
                            className="border-b border-gray-100 hover:bg-gray-50"
                          >
                            {/* 메뉴 그룹명 */}
                            <td className="p-3 text-xs text-gray-700 font-medium">
                              {perm.groupName}
                            </td>

                            {/* 페이지 선택 */}
                            <td className="p-2">
                              <select
                                value={perm.pageId ?? ''}
                                onChange={(e) =>
                                  handlePermChange(
                                    perm.menuGroupId,
                                    'pageId',
                                    e.target.value ? Number(e.target.value) : null,
                                  )
                                }
                                className="h-7 px-2 text-xs border border-gray-200 rounded w-full focus:outline-none focus:ring-1 focus:ring-blue-500 bg-white"
                              >
                                <option value="">선택</option>
                                {pages.map((p) => (
                                  <option key={p.id} value={p.id}>{p.pageName}</option>
                                ))}
                              </select>
                            </td>

                            {/* 저장 */}
                            <td className="p-3 text-center">
                              <input
                                type="checkbox"
                                checked={perm.isSave}
                                onChange={(e) =>
                                  handlePermChange(perm.menuGroupId, 'isSave', e.target.checked)
                                }
                                className="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
                              />
                            </td>

                            {/* 조회 */}
                            <td className="p-3 text-center">
                              <input
                                type="checkbox"
                                checked={perm.isRead}
                                onChange={(e) =>
                                  handlePermChange(perm.menuGroupId, 'isRead', e.target.checked)
                                }
                                className="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
                              />
                            </td>

                            {/* 삭제 */}
                            <td className="p-3 text-center">
                              <input
                                type="checkbox"
                                checked={perm.isDelete}
                                onChange={(e) =>
                                  handlePermChange(perm.menuGroupId, 'isDelete', e.target.checked)
                                }
                                className="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
                              />
                            </td>
                          </tr>
                        ))
                      )}
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          )}

          {/* ── 하단 버튼 ── */}
          <div className="flex justify-center gap-2 py-4 border-t border-gray-200 bg-white shrink-0">
            <button
              onClick={handleSave}
              className="h-8 px-8 text-sm text-white bg-blue-600 rounded hover:bg-blue-700"
            >
              저장
            </button>
            <button
              onClick={handleCancel}
              className="h-8 px-8 text-sm text-white bg-gray-500 rounded hover:bg-gray-600"
            >
              취소
            </button>
          </div>
        </div>
      </div>
    </div>
  );
}
