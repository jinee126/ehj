'use client';

import { useState, useCallback } from 'react';

// ── 프로젝트 공통 모듈 (경로는 프로젝트에 맞게 수정) ──────────────
// import { callGetAPI, HTTP_METHOD, BASE_URL, ResultCode, ServerResCode } from '@/utils/api';
const BASE_URL      = process.env.NEXT_PUBLIC_API_BASE_URL ?? '';
const HTTP_METHOD   = { GET: 'GET', POST: 'POST' } as const;
const ResultCode    = { ET00: 'ET00' };
const ServerResCode = { OK: '200' };

// ── 타입 정의 ──────────────────────────────────────────────────────
type RowStatus = 'create' | 'update' | 'delete';

interface PageInfo {
  id:       number | null;
  pageName: string;
  path:     string;
  isSave:   boolean;
  isRead:   boolean;
  isDelete: boolean;
  status?:  RowStatus;  // create | update | delete
}

interface CheckItem {
  id:    string;
  check: boolean;
}

// ── 공통 API 호출 함수 (프로젝트 callGetAPI 사용 시 이 함수 제거) ──
async function callGetAPI(
  url: string,
  method: string,
  params: Record<string, unknown>,
  body: Record<string, unknown>,
) {
  const query =
    method === HTTP_METHOD.GET && Object.keys(params).length
      ? '?' + new URLSearchParams(params as Record<string, string>).toString()
      : '';

  const res = await fetch(`${url}${query}`, {
    method,
    headers: { 'Content-Type': 'application/json' },
    ...(method !== HTTP_METHOD.GET && { body: JSON.stringify(body) }),
  });

  return res.json();
}

// ══════════════════════════════════════════════════════════════════
export default function PageManager() {

  const [keyword,           setKeyword]           = useState('');
  const [pageListData,      setPageListData]      = useState<PageInfo[]>([]);
  const [hookCheckItemList, setHookCheckItemList] = useState<CheckItem[]>([]);
  const [isCheckedAll,      setIsCheckedAll]      = useState(false);

  // ── 조회 ────────────────────────────────────────────────────────
  const fetchData = useCallback(async () => {
    const resultData = await callGetAPI(
      `${BASE_URL}/pages`,
      HTTP_METHOD.GET,
      { keyword },
      {},
    );

    if (resultData.resultCode === ResultCode.ET00) {
      if (resultData.resCode === ServerResCode.OK) {
        setPageListData(resultData.data);
        setHookCheckItemList([]);
        setIsCheckedAll(false);
      }
    }
  }, [keyword]);

  // ── 저장 ────────────────────────────────────────────────────────
  const regUpdateData = useCallback(async () => {
    // status가 create 또는 update인 행만 추출
    const changedRows = pageListData.filter(
      (item) => item.status === 'create' || item.status === 'update',
    );

    if (changedRows.length === 0) {
      alert('변경된 내용이 없습니다.');
      return;
    }

    const resultData = await callGetAPI(
      `${BASE_URL}/pages`,
      HTTP_METHOD.POST,
      {},
      { data: changedRows },
    );

    if (resultData.resultCode === ResultCode.ET00 && resultData.resCode === ServerResCode.OK) {
      alert('저장되었습니다.');
      await fetchData();
    }
  }, [pageListData, fetchData]);

  // ── 삭제 ────────────────────────────────────────────────────────
  const deleteData = useCallback(async () => {
    const checkedIds = new Set(
      hookCheckItemList.filter((c) => c.check).map((c) => c.id),
    );

    if (checkedIds.size === 0) {
      alert('삭제할 항목을 선택해 주세요.');
      return;
    }
    if (!confirm(`선택한 ${checkedIds.size}건을 삭제하시겠습니까?`)) return;

    const targetRows = pageListData.filter((_, index) =>
      checkedIds.has(`check_${index}`),
    );

    // 신규 행(status === 'create')만 있으면 서버 호출 없이 제거
    const onlyNew = targetRows.every((item) => item.status === 'create');
    if (onlyNew) {
      setPageListData((prev) =>
        prev.filter((_, index) => !checkedIds.has(`check_${index}`)),
      );
      setHookCheckItemList([]);
      setIsCheckedAll(false);
      return;
    }

    // 기존 행이 포함된 경우 status: 'delete'로 서버에 전송
    const resultData = await callGetAPI(
      `${BASE_URL}/pages`,
      HTTP_METHOD.POST,
      {},
      { data: targetRows.map((r) => ({ ...r, status: 'delete' })) },
    );

    if (resultData.resultCode === ResultCode.ET00 && resultData.resCode === ServerResCode.OK) {
      alert('삭제되었습니다.');
      await fetchData();
    }
  }, [pageListData, hookCheckItemList, fetchData]);

  // ── 행 추가 ────────────────────────────────────────────────────
  const handleAdd = useCallback(() => {
    const newRow: PageInfo = {
      id:       null,
      pageName: '',
      path:     '',
      isSave:   false,
      isRead:   false,
      isDelete: false,
      status:   'create',
    };
    setPageListData((prev) => [...prev, newRow]);
  }, []);

  // ── 셀 값 변경 ─────────────────────────────────────────────────
  const handleChange = useCallback((
    id: number | null,
    field: keyof PageInfo,
    value: string | boolean,
  ) => {
    setPageListData((prev) =>
      prev.map((r) =>
        r.id === id
          ? {
              ...r,
              [field]: value,
              // 신규 행은 create 유지, 기존 행은 update로 변경
              status: r.status === 'create' ? 'create' : 'update',
            }
          : r,
      ),
    );
  }, []);

  // ── 전체 선택 ──────────────────────────────────────────────────
  const handleSelectAll = useCallback((e: React.ChangeEvent<HTMLInputElement>) => {
    const checked = e.target.checked;
    setIsCheckedAll(checked);
    setHookCheckItemList(
      pageListData.map((_, index) => ({ id: `check_${index}`, check: checked })),
    );
  }, [pageListData]);

  // ── 개별 체크 ──────────────────────────────────────────────────
  const handleCheckItem = useCallback((e: React.ChangeEvent<HTMLInputElement>) => {
    const { id, checked } = e.target;
    setHookCheckItemList((prev) => {
      const exists = prev.find((c) => c.id === id);
      return exists
        ? prev.map((c) => (c.id === id ? { ...c, check: checked } : c))
        : [...prev, { id, check: checked }];
    });
  }, []);

  // ── Enter 검색 ────────────────────────────────────────────────
  const handleKeyDown = (e: React.KeyboardEvent<HTMLInputElement>) => {
    if (e.key === 'Enter') fetchData();
  };

  // ────────────────────────────────────────────────────────────────
  return (
    <div className="w-full">
      <div className="overflow-auto">
        <div className="bg-white w-full">

          {/* ── 상단 툴바 ── */}
          <div className="flex items-center justify-between px-4 py-3 border-b border-gray-200 bg-gray-50">
            <div className="flex items-center gap-2">
              <input
                type="text"
                placeholder="페이지명 / 경로 검색"
                value={keyword}
                onChange={(e) => setKeyword(e.target.value)}
                onKeyDown={handleKeyDown}
                className="w-56 h-8 px-3 text-sm border border-gray-300 rounded focus:outline-none focus:ring-1 focus:ring-blue-500 dark:bg-gray-800 dark:border-gray-600 dark:text-gray-200"
              />
              <button
                onClick={fetchData}
                className="h-8 px-4 text-sm text-white bg-gray-600 rounded hover:bg-gray-700"
              >
                조회
              </button>
            </div>

            <div className="flex items-center gap-1">
              <button
                onClick={handleAdd}
                className="h-8 px-4 text-sm text-white bg-gray-500 rounded hover:bg-gray-600"
              >
                추가
              </button>
              <button
                onClick={regUpdateData}
                className="h-8 px-4 text-sm text-white bg-blue-600 rounded hover:bg-blue-700"
              >
                저장
              </button>
              <button
                onClick={deleteData}
                className="h-8 px-4 text-sm text-white bg-red-600 rounded hover:bg-red-700"
              >
                삭제
              </button>
            </div>
          </div>

          {/* ── 테이블 ── */}
          <table className="text-gray-500 dark:text-gray-400 w-full">
            <thead className="text-xs text-gray-500 uppercase bg-gray-100 dark:bg-gray-700 dark:text-gray-400">
              <tr className="border-b">
                <th scope="col" className="text-left text-gray-500 uppercase p-4 w-12">번호</th>
                <th scope="col" className="text-left text-gray-500 p-4 w-10">
                  <input
                    type="checkbox"
                    id="checkAll"
                    checked={isCheckedAll}
                    onChange={handleSelectAll}
                    className="w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600"
                  />
                </th>
                <th scope="col" className="text-left text-gray-500 uppercase p-4">페이지명</th>
                <th scope="col" className="text-left text-gray-500 uppercase p-4">경로</th>
                <th scope="col" className="text-center text-gray-500 uppercase p-4 w-20">저장</th>
                <th scope="col" className="text-center text-gray-500 uppercase p-4 w-20">조회</th>
                <th scope="col" className="text-center text-gray-500 uppercase p-4 w-20">삭제</th>
              </tr>
            </thead>

            <tbody>
              {pageListData.length === 0 ? (
                <tr>
                  <td colSpan={7} className="text-center py-10 text-sm text-gray-400">
                    조회된 데이터가 없습니다.
                  </td>
                </tr>
              ) : (
                pageListData.map((item, index) => (
                  <tr
                    key={index}
                    className="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-100 font-medium text-gray-900 whitespace-nowrap dark:text-white"
                  >
                    {/* 번호 */}
                    <td className="p-4 text-sm">
                      {item.status === 'create'
                        ? <span className="text-xs text-orange-500 font-bold">NEW</span>
                        : index + 1}
                    </td>

                    {/* 행 체크박스 */}
                    <td className="p-4">
                      <input
                        type="checkbox"
                        id={`check_${index}`}
                        onChange={handleCheckItem}
                        checked={
                          hookCheckItemList.find((c) => c.id === `check_${index}`)?.check || false
                        }
                        className="w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600"
                      />
                    </td>

                    {/* 페이지명 */}
                    <td className="p-2">
                      <input
                        type="text"
                        value={item.pageName}
                        onChange={(e) => handleChange(item.id, 'pageName', e.target.value)}
                        placeholder="페이지명 입력"
                        className="block p-2 text-sm text-gray-900 bg-white border border-gray-200 rounded w-full focus:outline-none focus:ring-1 focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white"
                      />
                    </td>

                    {/* 경로 */}
                    <td className="p-2">
                      <input
                        type="text"
                        value={item.path}
                        onChange={(e) => handleChange(item.id, 'path', e.target.value)}
                        placeholder="/path"
                        className="block p-2 text-sm text-gray-900 bg-white border border-gray-200 rounded w-full focus:outline-none focus:ring-1 focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white"
                      />
                    </td>

                    {/* 저장 권한 */}
                    <td className="p-4 text-center">
                      <input
                        type="checkbox"
                        checked={item.isSave}
                        onChange={(e) => handleChange(item.id, 'isSave', e.target.checked)}
                        className="w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600"
                      />
                    </td>

                    {/* 조회 권한 */}
                    <td className="p-4 text-center">
                      <input
                        type="checkbox"
                        checked={item.isRead}
                        onChange={(e) => handleChange(item.id, 'isRead', e.target.checked)}
                        className="w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600"
                      />
                    </td>

                    {/* 삭제 권한 */}
                    <td className="p-4 text-center">
                      <input
                        type="checkbox"
                        checked={item.isDelete}
                        onChange={(e) => handleChange(item.id, 'isDelete', e.target.checked)}
                        className="w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600"
                      />
                    </td>
                  </tr>
                ))
              )}
            </tbody>
          </table>

        </div>
      </div>
    </div>
  );
}
