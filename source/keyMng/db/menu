-- ============================================================
--  계층형 메뉴 조회 쿼리 (Oracle CONNECT BY)
-- ============================================================
SELECT
  M.ID,
  M.PARENT_ID,
  LPAD(' ', M.DEPTH * 2) || M.MENU_NAME AS MENU_NAME,
  M.PAGE_ID,
  P.PAGE_NAME,
  P.PATH,
  M.SORT_ORDER,
  M.DEPTH,
  M.USE_YN
FROM MENU M
LEFT JOIN PAGE P ON P.ID = M.PAGE_ID
START WITH M.PARENT_ID IS NULL
CONNECT BY PRIOR M.ID = M.PARENT_ID
ORDER SIBLINGS BY M.SORT_ORDER;

-- ============================================================
--  특정 메뉴의 그룹별 권한 조회
-- ============================================================
SELECT
  MG.ID            AS MENU_GROUP_ID,
  MG.GROUP_NAME,
  MGP.PAGE_ID,
  P.PAGE_NAME,
  P.PATH,
  NVL(MGP.IS_SAVE,   'N') AS IS_SAVE,
  NVL(MGP.IS_READ,   'N') AS IS_READ,
  NVL(MGP.IS_DELETE, 'N') AS IS_DELETE
FROM MENU_GROUP MG
LEFT JOIN MENU_GROUP_PERMISSION MGP
  ON MGP.MENU_GROUP_ID = MG.ID
  AND MGP.MENU_ID = :menuId         -- 파라미터: 선택된 메뉴 ID
LEFT JOIN PAGE P ON P.ID = MGP.PAGE_ID
WHERE MG.USE_YN = 'Y'
ORDER BY MG.SORT_ORDER;
